{
  "manifest": 2,
  "api": 2,
  "id": "maodou-shiny",
  "version": "1.3.3",
  "name": {
    "zh": "异色大耳帽兜",
    "en": "Shiny Maodou"
  },
  "about": {
    "zh": "依据《洛克王国：世界》第一阶段异色大耳帽兜参考绘制的分层桌宠。圆滑帽兜、柔软长耳、连续侧转与近耳遮挡，配有 25 种表情、28 个动作及温柔、活泼两种性格。",
    "en": "A painted desktop pet based on first-stage Shiny Maodou from Roco Kingdom: World, with a rounded hood, soft long ears, continuous partial turns and near-ear occlusion, 25 expressions, 28 actions, and gentle or lively personalities."
  },
  "author": "Maodou character project",
  "license": "AGPL-3.0-or-later (code); character rights remain with their respective owners",
  "entry": "figure.js",
  "export": "createMaodouBody",
  "model": "model.json",
  "axes": [
    {
      "id": "personality",
      "name": {
        "zh": "性格",
        "en": "Personality"
      },
      "options": [
        {
          "id": "gentle",
          "name": {
            "zh": "温柔",
            "en": "Gentle"
          },
          "accent": "#90cada"
        },
        {
          "id": "lively",
          "name": {
            "zh": "活泼",
            "en": "Lively"
          },
          "accent": "#90cada"
        }
      ]
    }
  ],
  "presets": [],
  "vocab": [
    {
      "id": "neutral",
      "kind": "expression",
      "names": {
        "zh": [
          "平静"
        ]
      },
      "about": {
        "zh": "放松的青色眼睛与小嘴，轻轻呼吸。",
        "en": "Relaxed cyan eyes, a small resting mouth, and gentle breathing."
      },
      "seconds": 0.9
    },
    {
      "id": "happy",
      "kind": "expression",
      "names": {
        "zh": [
          "开心"
        ]
      },
      "about": {
        "zh": "开心地弯起眼睛，小嘴含笑，耳朵轻轻回应。",
        "en": "Happy curved eyes, a small smile, and a gentle ear response."
      },
      "seconds": 0.9
    },
    {
      "id": "wink",
      "kind": "expression",
      "names": {
        "zh": [
          "眨眼"
        ]
      },
      "about": {
        "zh": "单眼眨一下，另一只青色眼睛保留。",
        "en": "A one-eye wink while the other cyan eye stays visible."
      },
      "seconds": 0.9
    },
    {
      "id": "love",
      "kind": "expression",
      "names": {
        "zh": [
          "喜欢"
        ]
      },
      "about": {
        "zh": "温柔地望向你，脸颊微红，姿态亲近。",
        "en": "An affectionate gaze, a little blush, and a welcoming pose."
      },
      "seconds": 0.9
    },
    {
      "id": "shy",
      "kind": "expression",
      "names": {
        "zh": [
          "害羞"
        ]
      },
      "about": {
        "zh": "视线轻轻躲开，脸红并微微低头。",
        "en": "Averted gaze, blushing cheeks, and a small head dip."
      },
      "seconds": 0.9
    },
    {
      "id": "surprised",
      "kind": "expression",
      "names": {
        "zh": [
          "惊讶"
        ]
      },
      "about": {
        "zh": "青色眼睛睁圆，小嘴短暂张开。",
        "en": "Widened cyan eyes and a briefly open small mouth."
      },
      "seconds": 0.9
    },
    {
      "id": "angry",
      "kind": "expression",
      "names": {
        "zh": [
          "生气"
        ]
      },
      "about": {
        "zh": "眉眼收紧，小嘴认真抿起，克制地鼓起劲。",
        "en": "Tighter brows and eyes with a small determined mouth."
      },
      "seconds": 0.9
    },
    {
      "id": "sad",
      "kind": "expression",
      "names": {
        "zh": [
          "难过"
        ]
      },
      "about": {
        "zh": "眉尾放低、视线下垂，耳朵和重心轻轻沉下。",
        "en": "Lowered brows and gaze with softly drooping ears and posture."
      },
      "seconds": 0.9
    },
    {
      "id": "sleepy",
      "kind": "expression",
      "names": {
        "zh": [
          "犯困"
        ]
      },
      "about": {
        "zh": "眼皮慢慢变沉，带一次小小的哈欠。",
        "en": "Heavy eyelids and a small, slow yawn."
      },
      "seconds": 0.9
    },
    {
      "id": "thinking",
      "kind": "expression",
      "names": {
        "zh": [
          "思考"
        ]
      },
      "about": {
        "zh": "视线略向上偏，保持小口，轻轻歪头思考。",
        "en": "A slightly raised gaze and a thoughtful small head tilt."
      },
      "seconds": 0.9
    },
    {
      "id": "smug",
      "kind": "expression",
      "names": {
        "zh": [
          "得意"
        ]
      },
      "about": {
        "zh": "眼皮略收，嘴角轻扬，露出一点小得意。",
        "en": "Slightly lowered eyelids and a restrained smug smile."
      },
      "seconds": 0.9
    },
    {
      "id": "pout",
      "kind": "expression",
      "names": {
        "zh": [
          "嘟嘴"
        ]
      },
      "about": {
        "zh": "小嘴噘起，视线转开，脸颊微微发红。",
        "en": "A small pout with an averted gaze and a little blush."
      },
      "seconds": 0.9
    },
    {
      "id": "worried",
      "kind": "expression",
      "names": {
        "zh": [
          "担心"
        ]
      },
      "about": {
        "zh": "眉间轻蹙，眼睛保留纵向形状，紧张地望着前方。",
        "en": "Worried brows and attentive eyes that keep their tall shape."
      },
      "seconds": 0.9
    },
    {
      "id": "determined",
      "kind": "expression",
      "names": {
        "zh": [
          "认真"
        ]
      },
      "about": {
        "zh": "眼神专注，眉毛稍压，小爪稳稳收好。",
        "en": "Focused eyes, slightly lowered brows, and steady little paws."
      },
      "seconds": 0.9
    },
    {
      "id": "flustered",
      "kind": "expression",
      "names": {
        "zh": [
          "慌张"
        ]
      },
      "about": {
        "zh": "眼睛短暂收紧，脸颊泛红，随后缓缓回稳。",
        "en": "A brief flustered squint and blush followed by a gentle recovery."
      },
      "seconds": 0.9
    },
    {
      "id": "scared",
      "kind": "expression",
      "names": {
        "zh": [
          "害怕"
        ]
      },
      "about": {
        "zh": "睁大眼睛，眉毛上提，身体轻轻缩起。",
        "en": "Wide eyes, raised brows, and a small protective huddle."
      },
      "seconds": 0.9
    },
    {
      "id": "excited",
      "kind": "expression",
      "names": {
        "zh": [
          "兴奋"
        ]
      },
      "about": {
        "zh": "眼睛更精神，小嘴开心，姿态轻快地提起。",
        "en": "Bright, alert eyes and an excited upward posture."
      },
      "seconds": 0.9
    },
    {
      "id": "cry",
      "kind": "expression",
      "names": {
        "zh": [
          "哭泣"
        ]
      },
      "about": {
        "zh": "保留完整青色眼形，眉毛委屈，小泪滴从眼底落下。",
        "en": "Full cyan eyes, sad brows, and small tears falling from the lower lids."
      },
      "seconds": 0.9
    },
    {
      "id": "confused",
      "kind": "expression",
      "names": {
        "zh": [
          "疑惑"
        ]
      },
      "about": {
        "zh": "两侧眉眼略有不同，带一点不解的歪头。",
        "en": "Slightly asymmetric brows and eyes with a puzzled head tilt."
      },
      "seconds": 0.9
    },
    {
      "id": "cozy",
      "kind": "expression",
      "names": {
        "zh": [
          "安心"
        ]
      },
      "about": {
        "zh": "眼弧柔和，嘴角放松，双耳安静地垂落。",
        "en": "Soft eye curves, a relaxed mouth, and calmly resting ears."
      },
      "seconds": 0.9
    },
    {
      "id": "curious",
      "kind": "expression",
      "names": {
        "zh": [
          "好奇"
        ]
      },
      "about": {
        "zh": "带着上扬的视线轻轻探看，眉眼比思考更舒展。",
        "en": "An inquisitive upward gaze with more open brows than the thinking face."
      },
      "seconds": 0.9
    },
    {
      "id": "bashful",
      "kind": "expression",
      "names": {
        "zh": [
          "羞喜"
        ]
      },
      "about": {
        "zh": "开心又害羞地收起小爪，眼弧和脸红一起渐入。",
        "en": "A shy, happy smile with tucked paws and a gently arriving blush."
      },
      "seconds": 0.9
    },
    {
      "id": "pleading",
      "kind": "expression",
      "names": {
        "zh": [
          "委屈"
        ]
      },
      "about": {
        "zh": "纵向青眼略含泪意，眉毛柔软地抬起，小嘴轻抿。",
        "en": "Tall cyan eyes, gently raised sad brows, and a small pleading mouth."
      },
      "seconds": 0.9
    },
    {
      "id": "proud",
      "kind": "expression",
      "names": {
        "zh": [
          "小得意"
        ]
      },
      "about": {
        "zh": "稍稍抬头，眼睛仍然柔和，小嘴带一点自豪。",
        "en": "A modest head lift with soft eyes and a quietly proud mouth."
      },
      "seconds": 0.9
    },
    {
      "id": "sparkle",
      "kind": "expression",
      "names": {
        "zh": [
          "期待"
        ]
      },
      "about": {
        "zh": "保留青色眼睛，轻轻提眉睁眼，略向前倾着等待。",
        "en": "Keeps the cyan eyes, gently raises the brows and lids, and leans forward expectantly."
      },
      "seconds": 0.9
    },
    {
      "id": "stand",
      "kind": "motion",
      "names": {
        "zh": [
          "站起"
        ]
      },
      "about": {
        "zh": "从坐姿或困倦姿势缓缓站稳。",
        "en": "Returns gently to a standing posture."
      },
      "seconds": 1.2
    },
    {
      "id": "jump",
      "kind": "motion",
      "names": {
        "zh": [
          "跳起来"
        ]
      },
      "about": {
        "zh": "蹲下蓄力后原地起跳，落地时柔软回弹。",
        "en": "Crouches, jumps on the spot, and settles softly after landing."
      },
      "seconds": 1.2
    },
    {
      "id": "hop",
      "kind": "motion",
      "names": {
        "zh": [
          "小跳"
        ]
      },
      "about": {
        "zh": "做一次幅度较小的轻跳。",
        "en": "A small, light hop."
      },
      "seconds": 0.9
    },
    {
      "id": "look",
      "kind": "motion",
      "names": {
        "zh": [
          "张望"
        ]
      },
      "about": {
        "zh": "在有限侧向关键形状之间观察周围。",
        "en": "Looks around within the authored side-view range."
      },
      "seconds": 2.7
    },
    {
      "id": "turn",
      "kind": "motion",
      "names": {
        "zh": [
          "转身"
        ]
      },
      "about": {
        "zh": "改变朝向，头耳连续转动而不压成薄片。",
        "en": "Changes heading through continuous head and ear movement."
      },
      "seconds": 1.2
    },
    {
      "id": "nod",
      "kind": "motion",
      "names": {
        "zh": [
          "点头"
        ]
      },
      "about": {
        "zh": "轻轻低头应答，然后回到原位。",
        "en": "A gentle nod followed by a return to rest."
      },
      "seconds": 0.8
    },
    {
      "id": "shake",
      "kind": "motion",
      "names": {
        "zh": [
          "摇头"
        ]
      },
      "about": {
        "zh": "克制地左右摇头。",
        "en": "A restrained side-to-side head shake."
      },
      "seconds": 0.8
    },
    {
      "id": "spin",
      "kind": "motion",
      "names": {
        "zh": [
          "小转动"
        ]
      },
      "about": {
        "zh": "在正面与侧面间轻快转动，不展示背面。",
        "en": "A small turn between front and side views, without a back view."
      },
      "seconds": 0.8
    },
    {
      "id": "sit",
      "kind": "motion",
      "names": {
        "zh": [
          "坐下"
        ]
      },
      "about": {
        "zh": "缓缓坐下，并保持坐姿。",
        "en": "Sits down and holds the seated pose."
      },
      "seconds": 0.8,
      "lasting": true
    },
    {
      "id": "sleep",
      "kind": "motion",
      "names": {
        "zh": [
          "睡觉"
        ]
      },
      "about": {
        "zh": "合眼休息，维持缓慢呼吸。",
        "en": "Closes the eyes and rests with slow breathing."
      },
      "seconds": 0.8,
      "lasting": true
    },
    {
      "id": "dizzy",
      "kind": "motion",
      "names": {
        "zh": [
          "晕乎乎"
        ]
      },
      "about": {
        "zh": "短暂晕乎，身体与耳朵轻轻晃动。",
        "en": "A brief dizzy wobble through the body and ears."
      },
      "seconds": 3.2
    },
    {
      "id": "walk",
      "kind": "motion",
      "names": {
        "zh": [
          "散步"
        ]
      },
      "about": {
        "zh": "按照原生身体路径走一段，脚步与耳尾跟随移动。",
        "en": "Walks using the native body path with coordinated feet, ears, and tail."
      },
      "seconds": 12
    },
    {
      "id": "run",
      "kind": "motion",
      "names": {
        "zh": [
          "跑起来"
        ]
      },
      "about": {
        "zh": "向另一边轻快跑动，并在停止时收稳。",
        "en": "Runs towards the other side and settles on stopping."
      },
      "seconds": 12
    },
    {
      "id": "wave",
      "kind": "motion",
      "names": {
        "zh": [
          "招手"
        ]
      },
      "about": {
        "zh": "举起一只短爪挥一挥。",
        "en": "Raises one short paw for a small wave."
      },
      "seconds": 1.7
    },
    {
      "id": "bow",
      "kind": "motion",
      "names": {
        "zh": [
          "鞠躬"
        ]
      },
      "about": {
        "zh": "合眼并轻轻低头致意。",
        "en": "Closes the eyes and dips the head in greeting."
      },
      "seconds": 1.7
    },
    {
      "id": "shiver",
      "kind": "motion",
      "names": {
        "zh": [
          "发抖"
        ]
      },
      "about": {
        "zh": "缩起身子做小幅抖动，然后放松。",
        "en": "Huddles for a small shiver, then relaxes."
      },
      "seconds": 1.9
    },
    {
      "id": "flap",
      "kind": "motion",
      "names": {
        "zh": [
          "扑腾"
        ]
      },
      "about": {
        "zh": "短暂起跳，双耳随身体轻轻扑动。",
        "en": "A brief hop with a soft response through both ears."
      },
      "seconds": 1.5
    },
    {
      "id": "dance",
      "kind": "motion",
      "names": {
        "zh": [
          "跳舞"
        ]
      },
      "about": {
        "zh": "踩着节奏左右摆动，耳尾带有柔软延迟。",
        "en": "Rhythmic side-to-side steps with soft ear and tail follow-through."
      },
      "seconds": 3.4
    },
    {
      "id": "ear-wave",
      "kind": "motion",
      "names": {
        "zh": [
          "耳朵招手"
        ]
      },
      "about": {
        "zh": "一只耳朵主动抬起招手，另一只耳朵轻轻平衡。",
        "en": "One ear waves while the other softly balances the pose."
      },
      "seconds": 2.2
    },
    {
      "id": "ear-fold",
      "kind": "motion",
      "names": {
        "zh": [
          "抱耳"
        ]
      },
      "about": {
        "zh": "双耳柔软地向内折，小爪靠近耳边。",
        "en": "Folds both ears softly inward while the paws move closer."
      },
      "seconds": 2.7
    },
    {
      "id": "cuddle",
      "kind": "motion",
      "names": {
        "zh": [
          "贴近抱抱"
        ]
      },
      "about": {
        "zh": "身体向前亲近，小爪合拢，耳朵轻柔包住动作。",
        "en": "Leans closer with gathered paws and softly surrounding ears."
      },
      "seconds": 3
    },
    {
      "id": "peek",
      "kind": "motion",
      "names": {
        "zh": [
          "左右探头"
        ]
      },
      "about": {
        "zh": "先向一侧探头，再经过正面观察另一侧。",
        "en": "Peeks to one side, then crosses the front to inspect the other."
      },
      "seconds": 2.8
    },
    {
      "id": "stretch",
      "kind": "motion",
      "names": {
        "zh": [
          "伸懒腰"
        ]
      },
      "about": {
        "zh": "缓缓伸展身体和双耳，停留片刻后松下来。",
        "en": "Slowly stretches the body and ears, holds briefly, then relaxes."
      },
      "seconds": 3.2
    },
    {
      "id": "sway",
      "kind": "motion",
      "names": {
        "zh": [
          "轻轻摇摆"
        ]
      },
      "about": {
        "zh": "身体平缓地左右摇摆，耳尾略晚跟上。",
        "en": "Sways slowly from side to side with delayed ear and tail movement."
      },
      "seconds": 3
    },
    {
      "id": "bounce",
      "kind": "motion",
      "names": {
        "zh": [
          "尾巴弹跳"
        ]
      },
      "about": {
        "zh": "尾巴先轻轻弹动，带动身体做小幅回弹。",
        "en": "A small tail bounce leads into a restrained body rebound."
      },
      "seconds": 2.4
    },
    {
      "id": "doze",
      "kind": "motion",
      "names": {
        "zh": [
          "打瞌睡"
        ]
      },
      "about": {
        "zh": "眼皮渐沉，头部点落后轻轻回神。",
        "en": "The eyelids grow heavy and the head dips before gently recovering."
      },
      "seconds": 3.6
    },
    {
      "id": "greet",
      "kind": "motion",
      "names": {
        "zh": [
          "轻快招呼"
        ]
      },
      "about": {
        "zh": "抬头看向你，配合短爪与耳朵给出轻快回应。",
        "en": "Looks up with a coordinated paw and ear greeting."
      },
      "seconds": 2.5
    },
    {
      "id": "celebrate",
      "kind": "motion",
      "names": {
        "zh": [
          "雀跃庆祝"
        ]
      },
      "about": {
        "zh": "小爪、耳尾与重心交替上扬，开心庆祝后回稳。",
        "en": "Celebrates with alternating lifts through paws, ears, tail, and posture."
      },
      "seconds": 3.3
    }
  ],
  "sounds": {},
  "can": {
    "walk": true
  },
  "moves": [],
  "needs": []
}
